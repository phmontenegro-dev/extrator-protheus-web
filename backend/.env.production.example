# Arquivo-modelo para PRODUÇÃO.
# Copie para backend/.env na VM de produção e preencha os valores reais.
# NUNCA versione o .env real.

# ==== Ambiente ====
# "production" ativa:
#   - cookies de sessão com flag Secure (só viajam em HTTPS)
#   - outras futuras otimizações sensíveis a ambiente
ENV=production

# ==== PostgreSQL (banco interno: usuários/permissões/logs) ====
# Mesma VM, mesma rede loopback. Troque "senha_real" pela senha gerada na instalação.
#
# IMPORTANTE: se a senha contém caracteres especiais (@, #, :, /, etc),
# precisa URL-encode manualmente. Exemplos:
#   @ → %40     # → %23     : → %3A     / → %2F     ! → %21
# Senha "ti@2025" vira "ti%402025" na URL. O SQLAlchemy decodifica no uso.
POSTGRES_URL=postgresql+psycopg://extrator:senha_real@localhost:5432/extrator

# ==== Oracle Protheus (somente leitura) ====
ORACLE_HOST=ip_do_oracle_na_rede_interna
ORACLE_PORT=1521
ORACLE_SERVICE=nome_do_service
ORACLE_USER=usuario_oracle_so_select
ORACLE_PASSWORD=senha_oracle

# ==== Segurança ====
# Gerar com: python -c "import secrets; print(secrets.token_urlsafe(48))"
# OBRIGATÓRIO trocar — se ficar com a chave de dev, sessões de dev
# continuariam válidas aqui.
SECRET_KEY=TROQUE_POR_UMA_CHAVE_NOVA_DE_PELO_MENOS_48_CHARS

# ==== CORS ====
# Em produção o Nginx serve o frontend NO MESMO ORIGIN do backend
# (https://192.168.3.128/ e https://192.168.3.128/api/...), então CORS
# fica VAZIO — nenhum origin externo precisa acessar a API.
CORS_ORIGINS=

# ==== Caminhos de dados ====
# Pasta das planilhas de PROCV do CT2010. Em produção costuma ser:
PASTA_APOIO=/opt/extrator-protheus/tb_APOIO

# ==== Timeout de queries Oracle ====
ORACLE_QUERY_TIMEOUT_S=600
