# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ser versionado.

# ==== Ambiente ====
ENV=development

# ==== PostgreSQL (banco interno: usuarios/permissoes/logs) ====
POSTGRES_URL=postgresql+psycopg://extrator:senha_do_banco@localhost:5432/extrator

# ==== Oracle Protheus (dados dos relatórios — somente leitura) ====
ORACLE_HOST=ip_do_oracle
ORACLE_PORT=1521
ORACLE_SERVICE=nome_service
ORACLE_USER=usuario_oracle
ORACLE_PASSWORD=senha_oracle

# ==== Segurança ====
# Chave usada para assinar cookies de sessão. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_uma_chave_aleatoria_de_pelo_menos_48_chars

# ==== CORS (desenvolvimento) ====
# Em produção, quando o FastAPI servir o frontend buildado, deixe vazio.
CORS_ORIGINS=http://localhost:5173

# ==== Caminhos de dados ====
# Pasta com as planilhas de apoio do CT2010 (Plano de Contas, Centro de Custo).
PASTA_APOIO=/opt/extrator-protheus/ExtratorProtheus/tb_APOIO

# ==== Timeout de queries Oracle ====
# Segundos. Relatórios grandes podem precisar de mais tempo.
ORACLE_QUERY_TIMEOUT_S=600
