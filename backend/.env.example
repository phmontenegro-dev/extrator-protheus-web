# Copie este arquivo para .env e preencha com os valores reais.
# O .env NUNCA deve ser versionado.

# ==== Ambiente ====
ENV=development

# ==== PostgreSQL (banco interno: usuarios/permissoes/logs) ====
# IMPORTANTE: senhas com caracteres especiais precisam URL-encode:
#   @ → %40     # → %23     : → %3A     / → %2F     ! → %21
POSTGRES_URL=postgresql+psycopg://extrator:senha_do_banco@localhost:5432/extrator

# ==== Oracle Protheus (dados dos relatórios — somente leitura) ====
ORACLE_HOST=ip_do_oracle
ORACLE_PORT=1521
ORACLE_SERVICE=nome_service
ORACLE_USER=usuario_oracle
ORACLE_PASSWORD=senha_oracle

# ==== Segurança ====
# Chave usada para assinar cookies de sessão. Gerar com:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque_por_uma_chave_aleatoria_de_pelo_menos_48_chars

# ==== CORS (desenvolvimento) ====
# Em produção, quando o FastAPI servir o frontend buildado, deixe vazio.
CORS_ORIGINS=http://localhost:5173

# ==== Caminhos de dados ====
# Pasta com as planilhas de apoio do CT2010 (Plano de Contas, Centro de Custo).
PASTA_APOIO=/opt/extrator-protheus/ExtratorProtheus/tb_APOIO

# ==== Timeout de queries Oracle ====
# Segundos. Relatórios grandes podem precisar de mais tempo.
ORACLE_QUERY_TIMEOUT_S=600

# ==== Jobs assíncronos (Etapa 11) ====
# Pasta onde os CSVs dos jobs concluídos ficam salvos até a limpeza.
# Precisa ser gravável pelo usuário do uvicorn (ex: extrator, em produção).
#   sudo mkdir -p /var/lib/extrator/jobs
#   sudo chown extrator:extrator /var/lib/extrator/jobs
PASTA_JOBS=/var/lib/extrator/jobs
# Quantos jobs rodam em paralelo no mesmo processo FastAPI.
JOBS_MAX_WORKERS=2
# Quantos jobs (ativos + na fila) um usuário pode ter ao mesmo tempo.
JOBS_MAX_POR_USUARIO=1
# Dias de retenção dos jobs concluídos — a varredura via cron apaga depois disso.
JOBS_RETENCAO_DIAS=1

# ==== Agendamentos (Etapa 14) ====
# Base pública da API que será embutida no script sincronizador baixado pelo
# usuário. Precisa ser o endereço que a máquina do usuário vê — em produção,
# algo como http://192.168.3.128 (ou https://extrator.technocoat.local).
# Sem porta se Nginx estiver proxiando, com :8000 se for direto no uvicorn.
API_BASE_EXTERNA=http://192.168.3.128
